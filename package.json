{
  "name": "lojinha-da-katia-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Luxury editorial perfume showcase and WhatsApp consultation - no checkout",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "python3 -m http.server 5500",
    "check": "node tools/check-js.mjs && node tools/check-skelt-assets.mjs",
    "test": "node --test tests/*.test.js",
    "build": "node tools/build.mjs",
    "build:admin": "node tools/build-admin.mjs",
    "build:hml": "node tools/build-homologation.mjs",
    "smoke:public": "node scripts/public-api-smoke.mjs",
    "build:release": "node tools/build-release.mjs",
    "check:security": "node tools/check-security-output.mjs",
    "test:browser": "playwright test --config playwright.config.mjs",
    "test:iphone": "playwright test --config playwright.iphone.config.mjs",
    "test:admin-browser": "playwright test --config playwright.admin.config.mjs",
    "test:hml": "playwright test --config playwright.homologation.config.mjs",
    "check:skelt": "node tools/check-skelt-assets.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
